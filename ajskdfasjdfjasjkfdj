	if err != nil {
		return "", false
	}
	second, err := strconv.Atoi(m[2])
	if err != nil {
		return "", false
	}
	third, err := strconv.Atoi(m[3])
	if err != nil {
		return "", false
	}

	var year, month, day int
	switch {
	case first > 31:
		year, month, day = first, second, third
	case third > 31:
		year = third
		if first > 12 {
			day, month = first, second
		} else {
			month, day = first, second
		}
	default:
		return "", false
	}

	if year < 100 {
