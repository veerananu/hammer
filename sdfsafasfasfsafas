package bedrock

import (
	"context"
	"errors"
	"fmt"
	"strings"

	"github.com/aws/aws-sdk-go-v2/aws"
	"github.com/aws/aws-sdk-go-v2/service/bedrockruntime"
	bedrocktypes "github.com/aws/aws-sdk-go-v2/service/bedrockruntime/types"
	"go.uber.org/zap"
)

// ConverseClient is the subset of the AWS SDK client used by this package.
type ConverseClient interface {
	Converse(ctx context.Context, params *bedrockruntime.ConverseInput, optFns ...func(*bedrockruntime.Options)) (*bedrockruntime.ConverseOutput, error)
}

// GuardrailConfig holds optional guardrail settings for Bedrock.
type GuardrailConfig struct {
	GuardrailID      string
	GuardrailVersion string
}

// RequestConfig holds inference configuration for Bedrock calls.
type RequestConfig struct {
	ModelID     string
	MaxTokens   int
	Temperature float32
	ContactID   string // Optional: passed as RequestMetadata for tracing
	LogPayloads bool
}

// Usage holds token usage details including prompt cache metrics.
type Usage struct {
	InputTokens      int
	OutputTokens     int
	CacheReadTokens  int
	CacheWriteTokens int
}

// Service implements Bedrock Converse calls for extraction.
type Service struct {
	client          ConverseClient
	guardrailConfig GuardrailConfig
}

// NewService creates a new Bedrock service with optional guardrail configuration.
func NewService(client ConverseClient, guardrailConfig GuardrailConfig) *Service {
	return &Service{client: client, guardrailConfig: guardrailConfig}
}

// CallWithCache executes Converse with prompt cache enabled for the system prompt.
// It uses temperature and maxTokens from the provided RequestConfig.
func (s *Service) CallWithCache(ctx context.Context, systemPrompt, userMessage string, requestConfig RequestConfig) (string, *Usage, error) {
	input := s.buildConverseInput(systemPrompt, userMessage, requestConfig)
	logConverseRequest(systemPrompt, userMessage, requestConfig, input.GuardrailConfig != nil)

	out, err := s.client.Converse(ctx, input)
	if err != nil {
		return "", &Usage{}, fmt.Errorf("bedrock converse %s: %w", requestConfig.ModelID, err)
	}

	content, err := extractTextContent(out)
	if err != nil {
		return "", &Usage{}, err
	}

	usage := tokenUsageFromOutput(out)
	logConverseResponse(content, usage, requestConfig)

	return content, usage, nil
}

func (s *Service) buildConverseInput(systemPrompt, userMessage string, requestConfig RequestConfig) *bedrockruntime.ConverseInput {
	systemBlocks := []bedrocktypes.SystemContentBlock{
		&bedrocktypes.SystemContentBlockMemberText{Value: systemPrompt},
		&bedrocktypes.SystemContentBlockMemberCachePoint{Value: bedrocktypes.CachePointBlock{Type: bedrocktypes.CachePointTypeDefault}},
	}

	input := &bedrockruntime.ConverseInput{
		ModelId: aws.String(requestConfig.ModelID),
		System:  systemBlocks,
		Messages: []bedrocktypes.Message{
			{
				Role: bedrocktypes.ConversationRoleUser,
				Content: []bedrocktypes.ContentBlock{
					&bedrocktypes.ContentBlockMemberText{Value: userMessage},
				},
			},
		},
		InferenceConfig: &bedrocktypes.InferenceConfiguration{
			MaxTokens:   aws.Int32(int32(requestConfig.MaxTokens)),
			Temperature: aws.Float32(requestConfig.Temperature),
			TopP:        aws.Float32(0.1),
		},
	}

	// Add optional request metadata for tracing
	if requestConfig.ContactID != "" {
		input.RequestMetadata = map[string]string{
			"contact_id": requestConfig.ContactID,
		}
	}

	// Add guardrails if configured
	if guardrailConfigured(s.guardrailConfig) {
		input.GuardrailConfig = &bedrocktypes.GuardrailConfiguration{
			GuardrailIdentifier: aws.String(s.guardrailConfig.GuardrailID),
			GuardrailVersion:    aws.String(s.guardrailConfig.GuardrailVersion),
		}
	}

	return input
}

func guardrailConfigured(config GuardrailConfig) bool {
	return strings.TrimSpace(config.GuardrailID) != "" && strings.TrimSpace(config.GuardrailVersion) != ""
}

func logConverseRequest(systemPrompt, userMessage string, requestConfig RequestConfig, guardrailConfigured bool) {
	zap.L().Info("bedrock converse request",
		zap.String("modelId", requestConfig.ModelID),
		zap.String("contactId", requestConfig.ContactID),
		zap.Int("systemPromptChars", len(systemPrompt)),
		zap.Int("userMessageChars", len(userMessage)),
		zap.Int("maxTokens", requestConfig.MaxTokens),
		zap.Float32("temperature", requestConfig.Temperature),
		zap.Float32("topP", 0.1),
		zap.Bool("guardrailConfigured", guardrailConfigured),
		zap.Bool("payloadLogging", requestConfig.LogPayloads),
	)
	if requestConfig.LogPayloads {
		zap.L().Info("bedrock converse request payload",
			zap.String("modelId", requestConfig.ModelID),
			zap.String("contactId", requestConfig.ContactID),
			zap.String("systemPrompt", systemPrompt),
			zap.String("userMessage", userMessage),
		)
	}
}

func extractTextContent(out *bedrockruntime.ConverseOutput) (string, error) {
	messageOutput, ok := out.Output.(*bedrocktypes.ConverseOutputMemberMessage)
	if !ok {
		return "", errors.New("bedrock response does not contain a message output")
	}
	if len(messageOutput.Value.Content) == 0 {
		return "", errors.New("empty bedrock response")
	}

	for _, block := range messageOutput.Value.Content {
		if textBlock, isText := block.(*bedrocktypes.ContentBlockMemberText); isText {
			return textBlock.Value, nil
		}
	}

	return "", errors.New("no text content found in bedrock response")
}

func tokenUsageFromOutput(out *bedrockruntime.ConverseOutput) *Usage {
	usage := &Usage{}
	if out.Usage != nil {
		usage.InputTokens = int(aws.ToInt32(out.Usage.InputTokens))
		usage.OutputTokens = int(aws.ToInt32(out.Usage.OutputTokens))
		usage.CacheReadTokens = int(aws.ToInt32(out.Usage.CacheReadInputTokens))
		usage.CacheWriteTokens = int(aws.ToInt32(out.Usage.CacheWriteInputTokens))
	}

	return usage
}

func logConverseResponse(content string, usage *Usage, requestConfig RequestConfig) {
	zap.L().Info("bedrock converse response",
		zap.String("modelId", requestConfig.ModelID),
		zap.String("contactId", requestConfig.ContactID),
		zap.Int("responseChars", len(content)),
		zap.Any("usage", usage),
	)
	if requestConfig.LogPayloads {
		zap.L().Info("bedrock converse response payload",
			zap.String("modelId", requestConfig.ModelID),
			zap.String("contactId", requestConfig.ContactID),
			zap.String("responseText", content),
		)
	}
}
