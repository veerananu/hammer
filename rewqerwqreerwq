package main

import (
	"context"
	"errors"
	"testing"

	"github.com/aws/aws-lambda-go/events"


)

func connectEvent(contactID, intent string) events.ConnectEvent {
	return events.ConnectEvent{
		Name: "ContactFlowEvent",
		Details: events.ConnectDetails{
			ContactData: events.ConnectContactData{
				ContactID: contactID,
			},
			Parameters: map[string]string{
				"Intent": intent,
			},
		},
	}
}

func TestCreateHandler_BadIntent(t *testing.T) {
	// connect_event_bad_intent.json: empty Intent → handler returns error
	svc := service.New(
		func(_ context.Context, _ string) ([]string, error) { return nil, nil },
		func(_ context.Context, _ string) ([]model.EntityDefinition, error) { return nil, nil },
	)

	handler := CreateHandler(svc)
	_, err := handler(context.Background(), connectEvent("000472f6-2f93-485f-a1f3-b9057215a1e4", ""))
	if err == nil {
		t.Fatal("expected error for empty intent, got nil")
	}
}

func TestCreateHandler_NoData(t *testing.T) {
	// Service returns nil result (e.g. not-complete or no entity defs) → "false"
	svc := service.New(
		func(_ context.Context, _ string) ([]string, error) { return nil, nil },
		func(_ context.Context, _ string) ([]model.EntityDefinition, error) { return nil, nil },
	)

	handler := CreateHandler(svc)
	resp, err := handler(context.Background(), connectEvent(
		"000472f6-2f93-485f-a1f3-b9057215a1e4",
		"BANKING",
	))
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if resp["g_entity_extraction_status"] != "false" {
		t.Errorf("expected g_entity_extraction_status=false, got %q", resp["g_entity_extraction_status"])
	}
}

func TestCreateHandler_ServiceError(t *testing.T) {
	// Service returns an error → handler swallows it (fail-safe) and returns "false"
	svc := service.New(
		func(_ context.Context, _ string) ([]string, error) {
			return nil, errors.New("dynamo down")
		},
		func(_ context.Context, _ string) ([]model.EntityDefinition, error) { return nil, nil },
	)

	handler := CreateHandler(svc)
	resp, err := handler(context.Background(), connectEvent(
		"000472f6-2f93-485f-a1f3-b9057215a1e4",
		"BANKIE",
	))
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if resp["g_entity_extraction_status"] != "false" {
		t.Errorf("expected g_entity_extraction_status=false on error, got %q", resp["g_entity_extraction_status"])
	}
}

func TestCreateHandler_ValidEvent(t *testing.T) {
	// connect_event_happy.json + collection_complete + entity_config →
	// result is non-nil → "true"
	svc := service.New(
		func(_ context.Context, _ string) ([]string, error) {
			return []string{
				"Caller: Hey there, I need to send some money to my cousin out of state. It's kinda urgent for her.",
				"Bot: What type of transfer would you like to make? Zelle, domestic wire, or another type?",
				"Caller: Oh, hey! Yeah, I need to do a domestic wire transfer. I'm trying to send some money to my cousin out of state.",
				"Bot: You'd like help with your domestic wire transfer.",
			}, nil
		},
		func(_ context.Context, _ string) ([]model.EntityDefinition, error) {
			return []model.EntityDefinition{
				{EntityName: "transferType", EntityType: "categorical"},
				{EntityName: "amount", EntityType: "numeric"},
				{EntityName: "recipient", EntityType: "freeform"},
			}, nil
		},
	)

	handler := CreateHandler(svc)
	resp, err := handler(context.Background(), connectEvent(
		"000472f6-2f93-485f-a1f3-b9057215a1e4",
		"BANKIE",
	))
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if resp["extraction_status"] != "true" {
		t.Errorf("expected g_entity_extraction_status=true, got %q", resp["extraction_status"])
	}
}



