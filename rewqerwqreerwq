func TestExtractUtterances_AllTurns(t *testing.T) {
	// collection_complete.json: 2 turns, offset 0 → 4 utterances
	turns := []model.ConversationTurn{
		{
			TurnNumber:  1,
			UserInput:   "Hey there, I need to send some money to my cousin out of state. It's kinda urgent for her.",
			BotResponse: "What type of transfer would you like to make? Zelle, domestic wire, or another type?",
		},
		{
			TurnNumber:  2,
			UserInput:   "Oh, hey! Yeah, I need to do a domestic wire transfer. I'm trying to send some money to my cousin out of state.",
			BotResponse: "You'd like help with your domestic wire transfer.",
		},
	}

	utterances := extractUtterances(turns, 0)

	if len(utterances) != 4 {
		t.Fatalf("expected 4 utterances, got %d", len(utterances))
	}
	if utterances[0] != "Caller: Hey there, I need to send some money to my cousin out of state. It's kinda urgent for her." {
		t.Errorf("unexpected turn 1 caller: %q", utterances[0])
	}
	if utterances[1] != "Bot: What type of transfer would you like to make? Zelle, domestic wire, or another type?" {
		t.Errorf("unexpected turn 1 bot: %q", utterances[1])
	}
	if utterances[2] != "Caller: Oh, hey! Yeah, I need to do a domestic wire transfer. I'm trying to send some money to my cousin out of state." {
		t.Errorf("unexpected turn 2 caller: %q", utterances[2])
	}
	if utterances[3] != "Bot: You'd like help with your domestic wire transfer." {
		t.Errorf("unexpected turn 2 bot: %q", utterances[3])
	}
}

func TestExtractUtterances_WithOffset(t *testing.T) {
	// collection_offset3.json: 5 turns, LastCompletedTurnNumber=3 → turns[3:] → turns 4 and 5 → 4 utterances
	turns := []model.ConversationTurn{
		{TurnNumber: 1, UserInput: "Hi, I want to move money.", BotResponse: "Sure, what kind of transfer?"},
		{TurnNumber: 2, UserInput: "Between my own accounts.", BotResponse: "From which account?"},
		{TurnNumber: 3, UserInput: "Actually no, send it to my cousin.", BotResponse: "Okay, a wire to another person. What amount?"},
		{TurnNumber: 4, UserInput: "Five hundred dollars.", BotResponse: "Confirming a wire of five hundred dollars."},
		{TurnNumber: 5, UserInput: "Wire it please.", BotResponse: "Confirming your wire transfer."},
	}

	utterances := extractUtterances(turns, 3)

	if len(utterances) != 4 {
		t.Fatalf("expected 4 utterances (turns 4 and 5 only), got %d", len(utterances))
	}
	if utterances[0] != "Caller: Five hundred dollars." {
		t.Errorf("unexpected first utterance: %q", utterances[0])
	}
	if utterances[1] != "Bot: Confirming a wire of five hundred dollars." {
		t.Errorf("unexpected second utterance: %q", utterances[1])
	}
	if utterances[2] != "Caller: Wire it please." {
		t.Errorf("unexpected third utterance: %q", utterances[2])
	}
	if utterances[3] != "Bot: Confirming your wire transfer." {
		t.Errorf("unexpected fourth utterance: %q", utterances[3])
	}
}

func TestExtractUtterances_EmptyTurns(t *testing.T) {
	// collection_empty_turns.json: no turns → empty
	utterances := extractUtterances([]model.ConversationTurn{}, 0)
	if len(utterances) != 0 {
		t.Fatalf("expected 0 utterances, got %d", len(utterances))
	}
}

func TestExtractUtterances_OutOfRangeOffset(t *testing.T) {
	turns := []model.ConversationTurn{
		{TurnNumber: 1, UserInput: "Hello.", BotResponse: "Hi."},
	}
	// offset beyond slice length should reset to 0 and include all turns
	utterances := extractUtterances(turns, 99)
	if len(utterances) != 2 {
		t.Fatalf("expected 2 utterances after offset reset, got %d", len(utterances))
	}
}

