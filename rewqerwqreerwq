func TestLoad_BothPresent(t *testing.T) {
	// collection_complete.json + entity_config.json:
	// 4 utterances + 3 entity defs → populated Result
	utterances := []string{
		"Caller: Hey there, I need to send some money to my cousin out of state. It's kinda urgent for her.",
		"Bot: What type of transfer would you like to make? Zelle, domestic wire, or another type?",
		"Caller: Oh, hey! Yeah, I need to do a domestic wire transfer. I'm trying to send some money to my cousin out of state.",
		"Bot: You'd like help with your domestic wire transfer.",
	}
	defs := []model.EntityDefinition{
		{EntityName: "transferType", EntityType: "categorical"},
		{EntityName: "amount", EntityType: "numeric"},
		{EntityName: "recipient", EntityType: "freeform"},
	}

	svc := New(
		func(_ context.Context, _ string) ([]string, error) { return utterances, nil },
		func(_ context.Context, _ string) ([]model.EntityDefinition, error) { return defs, nil },
	)

	result, err := svc.Load(context.Background(), contactID(t), intent(t))
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if result == nil {
		t.Fatal("expected non-nil result")
	}
	if len(result.Utterances) != 4 {
		t.Errorf("expected 4 utterances, got %d", len(result.Utterances))
	}
	if len(result.EntityDefs) != 3 {
		t.Errorf("expected 3 entity defs, got %d", len(result.EntityDefs))
	}
}










